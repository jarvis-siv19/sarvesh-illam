# Copy to .env and fill in your own values:  cp .env.example .env
#
# A dedicated stream user created on each DVR (Main Menu -> Account).
# Both DVRs are expected to share the same username/password.
# Avoid special characters, or they must be URL-encoded in the RTSP URL.
DVR_USER=changeme
DVR_PASS=changeme

# DVR addresses. Pin these static ON THE DVR itself (Main Menu -> Network -> TCP/IP).
# A router DHCP reservation is unreliable here: these units present a different
# MAC address on each reboot, so the reservation won't match.
DVR1_HOST=192.168.0.50
DVR2_HOST=192.168.0.8

# LAN address of the machine running go2rtc — announced as a WebRTC candidate
# so phones/TVs on the LAN can stream. Give this machine a DHCP reservation on
# the router (its MAC is stable) or a manual IP, so the address doesn't drift.
LAN_IP=192.168.0.4

# Telegram alerts (optional — see README "Telegram setup"). Leave empty to
# keep events local (log + dashboard bell menu only).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
